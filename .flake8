# flake8 cannot read pyproject.toml; Black/isort settings live there.
[flake8]
max-line-length = 88
# E402: scripts put the repo root on sys.path before importing project modules.
extend-ignore = E203, W503, E501, E402
extend-exclude = .venv, build, dist, paper, wandb
# Package __init__ files re-export their public API.
per-file-ignores = __init__.py: F401
